# Copy to .env and change for any non-local deployment
POSTGRES_USER=veritas
POSTGRES_PASSWORD=change-me
MINIO_ROOT_USER=veritas-admin
MINIO_ROOT_PASSWORD=change-me-too
# First admin, created on startup only when no users exist
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-admin
# true when served over HTTPS
COOKIE_SECURE=false
# Long random string (e.g. `python -c "import secrets;print(secrets.token_hex(32))"`); keys OTP code hashes
SECRET_KEY=change-me-to-a-long-random-string
ALLOW_SIGNUP=true
# SMTP for sign-up verification codes. Leave SMTP_HOST empty to print codes in `docker compose logs backend`.
# Gmail example: SMTP_HOST=smtp.gmail.com SMTP_PORT=587 SMTP_SECURITY=starttls, SMTP_USER=you@gmail.com,
# SMTP_PASSWORD=<16-char app password>, SMTP_FROM=you@gmail.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_SECURITY=starttls
# 1 = install PaddleOCR in the backend image (large)
WITH_OCR=0
