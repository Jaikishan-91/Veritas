# Copy to .env and change for any non-local deployment
POSTGRES_USER=veritas
POSTGRES_PASSWORD=change-me
MINIO_ROOT_USER=veritas-admin
MINIO_ROOT_PASSWORD=change-me-too
# First admin, created on startup only when no users exist
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-admin
# true when served over HTTPS
COOKIE_SECURE=false
# 1 = install PaddleOCR in the backend image (large)
WITH_OCR=0
